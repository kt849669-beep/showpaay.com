{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/login", "destination": "/user-app/pages/login.html" },
    { "source": "/home", "destination": "/user-app/pages/home.html" },
    { "source": "/complete", "destination": "/user-app/pages/complete.html" },
    { "source": "/admin", "destination": "/admin-app/pages/login.html" },
    { "source": "/homepages", "destination": "/homepages.html" },
    { "source": "/showpay/homepages", "destination": "/showpay/homepages/index.html" },
    { "source": "/about-showpay", "destination": "/about-showpay.html" },
    { "source": "/showpay-apk", "destination": "/showpay-apk.html" },
    { "source": "/showpay-usdt", "destination": "/showpay-usdt.html" },
    { "source": "/showpay-guide", "destination": "/showpay-guide.html" }
  ],
  "headers": [
    {
      "source": "/admin(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
      ]
    }
  ]
}

{
  "name": "showpay-html",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "main": "scripts/node-server.mjs",
  "scripts": {
    "generate:seo": "node seo-generator.cjs",
    "prebuild": "npm run generate:seo",
    "dev": "vite --port=3000 --host=0.0.0.0",
    "start": "node scripts/node-server.mjs",
    "build": "vite build",
    "postbuild": "node scripts/cloudflare-seo-build.cjs && node deploy-landing.cjs && node apply-branding.cjs",
    "preview": "vite preview",
    "pretest:seo": "npm run generate:seo",
    "test:seo": "node tests/seo-audit.mjs",
    "test:seo-monitor": "node --test --test-isolation=none seo-monitor/tests/monitor.test.mjs",
    "monitor:seo": "node seo-monitor/run.mjs",
    "test:hosting": "node --test tests/node-hosting.test.mjs tests/orbit-mysql.test.mjs"
  },
  "dependencies": {
    "mysql2": "^3.24.5",
    "vite": "^6.2.3"
  },
  "engines": {
    "node": ">=22"
  }
}
